---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIntro from '../../components/ToolIntro.astro';
import ToolFooterContent from '../../components/ToolFooterContent.astro';
---
<BaseLayout title="Cron Expression Generator — build and verify schedules" description="Generate readable cron expressions, parse existing schedules, and preview the next three runs with timezone context." currentPath="/cron-generator/" tool="cron">
  <main class="site-main site-shell">
    <ToolIntro eyebrow="Scheduling" title="Make recurring work readable." lede="Build a cron schedule from familiar fields, parse an existing expression, and verify what will run next instead of guessing." detail="5-field cron · timezone-aware preview" />
    <div class="tool-grid">
      <section class="tool-card" aria-labelledby="cron-form-title">
        <div class="tool-card__head"><div><p class="eyebrow">Expression</p><h2 id="cron-form-title">Schedule builder</h2></div><span class="mono muted">cron_01</span></div>
        <div class="tool-card__body">
          <form id="cron-form">
            <div class="field-grid">
              <div class="field full"><label for="expression">Cron expression</label><input id="expression" value="0 9 * * 1-5" spellcheck="false" aria-describedby="cron-help" /><p class="field__hint" id="cron-help">minute hour day-of-month month day-of-week</p></div>
              <div class="field"><label for="minute">Minute</label><input id="minute" value="0" spellcheck="false" /></div>
              <div class="field"><label for="hour">Hour</label><input id="hour" value="9" spellcheck="false" /></div>
              <div class="field"><label for="day">Day of month</label><input id="day" value="*" spellcheck="false" /></div>
              <div class="field"><label for="month">Month</label><input id="month" value="*" spellcheck="false" /></div>
              <div class="field"><label for="weekday">Day of week</label><input id="weekday" value="1-5" spellcheck="false" /></div>
              <div class="field"><label for="timezone">Timezone</label><select id="timezone"><option value="UTC">UTC</option><option value="America/New_York">America/New_York</option><option value="Europe/London">Europe/London</option><option value="Asia/Kolkata">Asia/Kolkata</option><option value="Asia/Tokyo">Asia/Tokyo</option></select></div>
            </div>
            <div class="button-row tool-actions"><button class="button" type="submit">Check schedule <span aria-hidden="true">→</span></button><button class="button secondary" type="button" id="preset-hourly">Hourly</button><button class="button secondary" type="button" id="preset-weekday">Weekdays</button></div>
          </form>
          <p id="cron-status" class="status" aria-live="polite"></p>
        </div>
      </section>
      <aside class="tool-card result-panel" aria-labelledby="cron-result-title">
        <div class="tool-card__head"><div><p class="eyebrow">Output</p><h2 id="cron-result-title">Schedule reading</h2></div><span class="mono" id="cron-validity">—</span></div>
        <div class="tool-card__body">
          <p class="result-label">Human-readable meaning</p><p class="result-value" id="cron-description">—</p>
          <div class="result-stack"><p class="result-label">Next runs in <span id="cron-timezone">UTC</span></p><div id="next-runs"></div></div>
          <div class="tool-note"><p><strong>Dialect note.</strong></p><p>Vixie cron, Quartz, cloud schedulers, and CI systems do not all share the same field count or special syntax. Confirm the target runtime before shipping.</p></div>
          <button class="button secondary" type="button" id="copy-cron">Copy expression</button>
        </div>
      </aside>
    </div>
    <section class="section" aria-labelledby="cron-faq-title"><div class="section-head"><div><p class="eyebrow">Notes</p><h2 id="cron-faq-title">The best cron expression is the one your runtime agrees with.</h2></div><p>Use the explanation and next-run preview to catch the common errors: a swapped field, an unexpected timezone, or a schedule that fires more often than intended.</p></div><div class="faq-list"><details open><summary>What does the five-field format mean?</summary><p>The common Unix format is minute, hour, day of month, month, and day of week. Some tools add seconds or a year field.</p></details><details><summary>Does the preview change my server timezone?</summary><p>No. It only calculates the next dates using the timezone you choose so you can compare the schedule with your deployment environment.</p></details><details><summary>Can I use ranges and steps?</summary><p>Yes for common five-field syntax: ranges such as 1-5, lists such as 1,3,5, and steps such as */15 are supported by the parser used here.</p></details></div></section>
    <ToolFooterContent title="Schedules should explain themselves." copy="A good cron tool shows the expression, the sentence, and the next dates together." href="/schema-generator/" label="Next: generate schema" />
  </main>
</BaseLayout>

<script>
  import { buildCron, inspectCron } from '../../lib/cron';

  const form = document.querySelector<HTMLFormElement>('#cron-form');
  const expression = document.querySelector<HTMLInputElement>('#expression');
  const description = document.querySelector<HTMLElement>('#cron-description');
  const nextRuns = document.querySelector<HTMLElement>('#next-runs');
  const status = document.querySelector<HTMLElement>('#cron-status');
  const validity = document.querySelector<HTMLElement>('#cron-validity');
  const timezoneLabel = document.querySelector<HTMLElement>('#cron-timezone');
  const field = (id: string) => document.querySelector<HTMLInputElement>(id);
  function setStatus(message: string, tone: 'info' | 'success' | 'error' = 'info') { if (status) { status.textContent = message; status.dataset.tone = tone; } }
  function syncFieldsFromExpression() { const parts = (expression?.value.trim() ?? '').split(/\s+/); ['#minute', '#hour', '#day', '#month', '#weekday'].forEach((selector, index) => { const input = field(selector); if (input && parts[index]) input.value = parts[index]; }); }
  function syncExpressionFromFields() { if (expression) expression.value = buildCron({ minute: field('#minute')?.value ?? '*', hour: field('#hour')?.value ?? '*', day: field('#day')?.value ?? '*', month: field('#month')?.value ?? '*', weekday: field('#weekday')?.value ?? '*' }); }
  function render() {
    const tz = document.querySelector<HTMLSelectElement>('#timezone')?.value ?? 'UTC';
    const result = inspectCron(expression?.value ?? '', new Date(), tz);
    if (timezoneLabel) timezoneLabel.textContent = tz;
    if (validity) validity.textContent = result.valid ? 'valid' : 'check';
    if (description) description.textContent = result.valid ? result.description : '—';
    if (nextRuns) nextRuns.innerHTML = result.valid ? result.nextRuns.map((date) => `<div class="result-row"><span class="mono">${new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeStyle: 'short', timeZone: tz }).format(new Date(date))}</span><span class="muted">${tz}</span></div>`).join('') : '<p class="status">No run preview until the expression is valid.</p>';
    setStatus(result.valid ? 'Expression parsed successfully.' : result.error ?? 'Check the expression.', result.valid ? 'success' : 'error');
  }
  expression?.addEventListener('input', () => { syncFieldsFromExpression(); render(); });
  ['#minute', '#hour', '#day', '#month', '#weekday', '#timezone'].forEach((selector) => document.querySelector(selector)?.addEventListener('input', () => { syncExpressionFromFields(); render(); }));
  form?.addEventListener('submit', (event) => { event.preventDefault(); render(); });
  document.querySelector<HTMLButtonElement>('#preset-hourly')?.addEventListener('click', () => { if (expression) expression.value = '0 * * * *'; syncFieldsFromExpression(); render(); });
  document.querySelector<HTMLButtonElement>('#preset-weekday')?.addEventListener('click', () => { if (expression) expression.value = '0 9 * * 1-5'; syncFieldsFromExpression(); render(); });
  document.querySelector<HTMLButtonElement>('#copy-cron')?.addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; await navigator.clipboard.writeText(expression?.value ?? ''); button.textContent = 'Copied'; button.dataset.state = 'success'; window.setTimeout(() => { button.textContent = 'Copy expression'; delete button.dataset.state; }, 2500); });
  render();
</script>
