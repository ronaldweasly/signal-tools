---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Research from '../../../research/market-opportunity.md';
---
<BaseLayout title="Market research — Signal Tools" description="Research notes behind the five Signal Tools opportunities, with sources, caveats, and build decisions.">
  <main class="site-main site-shell">
    <header class="page-intro"><div><p class="eyebrow">Research log</p><h1>Evidence before code.</h1></div><div class="page-intro__aside"><p class="page-intro__lede">The five tools were selected from a cross-check of Google Trends methodology, Ahrefs, Semrush, public keyword data, competitor traffic reports, and developer utility directories.</p><p class="status mono">Updated 2026-08-22 · estimates vary by source</p></div></header>
    <article class="research-content">
      <Research />
    </article>
  </main>
</BaseLayout>

<style>
  .research-content { max-width: 78ch; color: var(--color-ink-soft); }
  .research-content :global(h2) { margin-top: var(--space-3xl); color: var(--color-ink); font: 600 var(--text-2xl)/1.1 var(--font-display); letter-spacing: -0.03em; }
  .research-content :global(h3) { margin-top: var(--space-2xl); color: var(--color-ink); font: 600 var(--text-xl)/1.2 var(--font-display); }
  .research-content :global(p), .research-content :global(li) { max-width: 72ch; }
  .research-content :global(a) { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .research-content :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: var(--text-sm); }
  .research-content :global(th), .research-content :global(td) { min-width: 160px; padding: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); text-align: left; vertical-align: top; }
  .research-content :global(th) { color: var(--color-muted); font: 600 var(--text-xs)/1.3 var(--font-mono); }
  .research-content :global(code) { padding: 0.1em 0.3em; background: var(--color-paper-2); font-family: var(--font-mono); font-size: 0.9em; }
</style>
