---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIntro from '../../components/ToolIntro.astro';
import ToolFooterContent from '../../components/ToolFooterContent.astro';
---
<BaseLayout title="LLM Cost Calculator — compare AI API spend" description="Estimate token usage and compare input, output, cached-token, daily, monthly, and yearly LLM API costs in your browser." currentPath="/llm-cost-calculator/" tool="llm">
  <main class="site-main site-shell">
    <ToolIntro eyebrow="AI economics" title="Price the workload, not the hype." lede="Estimate prompt tokens, compare model rates, and see what a recurring workload could cost before it becomes a surprise on the bill." detail="Approximate token counts · verify current provider rates" />
    <div class="tool-grid">
      <section class="tool-card" aria-labelledby="cost-form-title">
        <div class="tool-card__head"><div><p class="eyebrow">Scenario</p><h2 id="cost-form-title">Usage profile</h2></div><span class="mono muted">ai_01</span></div>
        <div class="tool-card__body">
          <form id="cost-form">
            <div class="field-grid">
              <div class="field full"><label for="prompt">Prompt sample <span class="muted">optional</span></label><textarea id="prompt" placeholder="Paste a representative prompt to estimate input tokens locally.">Summarize the key risks in this product brief and return three prioritized actions.</textarea><p class="field__hint" id="token-hint">Estimated locally from text length.</p></div>
              <div class="field"><label for="model">Model</label><select id="model"></select></div>
              <div class="field"><label for="input-tokens">Input tokens / request</label><input id="input-tokens" type="number" min="0" step="1" value="18" /></div>
              <div class="field"><label for="output-tokens">Output tokens / request</label><input id="output-tokens" type="number" min="0" step="1" value="240" /></div>
              <div class="field"><label for="cached-tokens">Cached input / request</label><input id="cached-tokens" type="number" min="0" step="1" value="0" /></div>
              <div class="field"><label for="requests-day">Requests / day</label><input id="requests-day" type="number" min="0" step="1" value="500" /></div>
            </div>
            <div class="button-row tool-actions"><button class="button" type="submit">Estimate cost <span aria-hidden="true">→</span></button><button class="button secondary" type="button" id="use-ai-sample">Use sample workload</button></div>
          </form>
          <p id="cost-status" class="status" aria-live="polite"></p>
        </div>
      </section>
      <aside class="tool-card result-panel" aria-labelledby="cost-result-title">
        <div class="tool-card__head"><div><p class="eyebrow">Output</p><h2 id="cost-result-title">Scenario cost</h2></div><span class="mono" id="provider-label">—</span></div>
        <div class="tool-card__body">
          <p class="result-label">Estimated monthly cost</p><p class="result-value" id="monthly-cost">$0.00</p>
          <div class="result-stack" id="cost-breakdown"></div>
          <div class="tool-note"><p><strong>Read this as a planning estimate.</strong></p><p>Prices change, providers offer batch/priority tiers, and exact tokenizers differ. Confirm the linked provider rate before committing a budget.</p><p class="source-links"><a href="https://developers.openai.com/api/docs/models" target="_blank" rel="noreferrer">OpenAI</a> · <a href="https://platform.claude.com/docs/en/about-claude/pricing" target="_blank" rel="noreferrer">Anthropic</a> · <a href="https://ai.google.dev/gemini-api/docs/pricing" target="_blank" rel="noreferrer">Google</a></p></div>
          <button class="button secondary" type="button" id="copy-cost">Copy estimate</button>
        </div>
      </aside>
    </div>
    <section class="section" aria-labelledby="compare-title">
      <div class="section-head"><div><p class="eyebrow">Same workload</p><h2 id="compare-title">Compare the scenario across models.</h2></div><p id="compare-caption">The rows below use the same token and request profile, so the comparison is directional rather than a benchmark.</p></div>
      <div class="tool-card"><div class="tool-card__body table-wrap"><table class="spec-table"><thead><tr><th>Provider</th><th>Model</th><th>Per request</th><th>Per month</th></tr></thead><tbody id="comparison-rows"></tbody></table></div></div>
    </section>
    <section class="section" aria-labelledby="cost-faq-title"><div class="section-head"><div><p class="eyebrow">Notes</p><h2 id="cost-faq-title">Token math is simple. Pricing context is not.</h2></div><p>Separate input, output, and cached input tokens so the model comparison remains legible when caching or batch discounts enter the conversation.</p></div><div class="faq-list"><details open><summary>How is the estimate calculated?</summary><p>Input tokens are multiplied by the model’s input rate, output tokens by the output rate, and cached tokens by the cached-input rate. The result is scaled by requests per day and 30 days.</p></details><details><summary>Is the token count exact?</summary><p>No. The browser estimate uses a transparent character heuristic. Exact tokenization varies by model and tokenizer, so use the result for planning and verify with the provider SDK before launch.</p></details><details><summary>Does the tool send my prompt to a server?</summary><p>No. The prompt is processed in your browser and is not required to calculate a scenario.</p></details></div></section>
    <ToolFooterContent title="Make the cost visible early." copy="A small scenario model is enough to catch an order-of-magnitude surprise before it reaches production." href="/cron-generator/" label="Next: schedule a recurring job" />
  </main>
</BaseLayout>

<script>
  import { MODEL_PRICING, estimateCost, estimateTokens, money } from '../../lib/llm';

  const form = document.querySelector<HTMLFormElement>('#cost-form');
  const modelSelect = document.querySelector<HTMLSelectElement>('#model');
  const prompt = document.querySelector<HTMLTextAreaElement>('#prompt');
  const status = document.querySelector<HTMLElement>('#cost-status');
  const comparisonRows = document.querySelector<HTMLElement>('#comparison-rows');
  const monthly = document.querySelector<HTMLElement>('#monthly-cost');
  const breakdown = document.querySelector<HTMLElement>('#cost-breakdown');
  const providerLabel = document.querySelector<HTMLElement>('#provider-label');
  const tokenHint = document.querySelector<HTMLElement>('#token-hint');
  let currentText = '';

  MODEL_PRICING.forEach((model) => { if (modelSelect) modelSelect.add(new Option(`${model.provider} · ${model.name}`, model.id)); });
  function numberValue(id: string) { return Number(document.querySelector<HTMLInputElement>(id)?.value ?? 0); }
  function selectedModel() { return MODEL_PRICING.find((model) => model.id === modelSelect?.value) ?? MODEL_PRICING[0]; }
  function setStatus(message: string, tone: 'info' | 'success' | 'error' = 'info') { if (status) { status.textContent = message; status.dataset.tone = tone; } }
  function render() {
    const model = selectedModel();
    const inputs = { inputTokens: numberValue('#input-tokens'), outputTokens: numberValue('#output-tokens'), cachedTokens: numberValue('#cached-tokens'), requestsPerDay: numberValue('#requests-day') };
    const estimate = estimateCost(model, inputs);
    if (monthly) monthly.textContent = money(estimate.perMonth);
    if (providerLabel) providerLabel.textContent = model.provider;
    if (breakdown) breakdown.innerHTML = `<div class="result-row"><span>Per request</span><strong>${money(estimate.perRequest)}</strong></div><div class="result-row"><span>Per day</span><strong>${money(estimate.perDay)}</strong></div><div class="result-row"><span>Per year</span><strong>${money(estimate.perYear)}</strong></div>`;
    if (comparisonRows) comparisonRows.innerHTML = MODEL_PRICING.map((row) => { const cost = estimateCost(row, inputs); return `<tr><td>${row.provider}</td><td>${row.name}</td><td>${money(cost.perRequest)}</td><td>${money(cost.perMonth)}</td></tr>`; }).join('');
    currentText = `${model.name} estimate\nPer request: ${money(estimate.perRequest)}\nPer month: ${money(estimate.perMonth)}\nPer year: ${money(estimate.perYear)}`;
    setStatus('Estimate updated. Provider prices are reference inputs, not a quote.', 'success');
  }
  prompt?.addEventListener('input', () => { const tokens = estimateTokens(prompt.value); const input = document.querySelector<HTMLInputElement>('#input-tokens'); if (input) input.value = String(tokens); if (tokenHint) tokenHint.textContent = `${tokens.toLocaleString()} estimated input tokens from this sample.`; });
  form?.addEventListener('submit', (event) => { event.preventDefault(); render(); });
  document.querySelector<HTMLButtonElement>('#use-ai-sample')?.addEventListener('click', () => { if (prompt) prompt.value = 'Classify each support ticket, summarize the issue, and return a suggested response with a confidence note.'; prompt?.dispatchEvent(new Event('input')); const requests = document.querySelector<HTMLInputElement>('#requests-day'); if (requests) requests.value = '2500'; render(); });
  document.querySelector<HTMLButtonElement>('#copy-cost')?.addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; await navigator.clipboard.writeText(currentText); button.textContent = 'Copied'; button.dataset.state = 'success'; window.setTimeout(() => { button.textContent = 'Copy estimate'; delete button.dataset.state; }, 2500); });
  render();
</script>
