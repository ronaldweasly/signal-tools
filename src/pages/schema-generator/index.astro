---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIntro from '../../components/ToolIntro.astro';
import ToolFooterContent from '../../components/ToolFooterContent.astro';
---
<BaseLayout title="JSON-LD Schema Generator — paste-ready structured data" description="Generate JSON-LD structured data for Article, FAQPage, Organization, Product, Event, BreadcrumbList, and LocalBusiness pages." currentPath="/schema-generator/">
  <main class="site-main site-shell">
    <ToolIntro eyebrow="Search structure" title="Make the page legible to machines." lede="Build valid-looking, paste-ready JSON-LD for common Schema.org types with a form that keeps the required fields visible." detail="No rich-result guarantee · validate before publishing" />
    <div class="tool-grid">
      <section class="tool-card" aria-labelledby="schema-form-title">
        <div class="tool-card__head"><div><p class="eyebrow">Schema type</p><h2 id="schema-form-title">Structured data builder</h2></div><span class="mono muted">jsonld_01</span></div>
        <div class="tool-card__body">
          <form id="schema-form">
            <div class="field"><label for="schema-type">Choose a type</label><select id="schema-type"><option value="Article">Article</option><option value="FAQPage">FAQ page</option><option value="Organization">Organization</option><option value="Product">Product</option><option value="Event">Event</option><option value="BreadcrumbList">Breadcrumbs</option><option value="LocalBusiness">Local business</option></select></div>
            <div id="schema-fields" class="field-grid" style="margin-top: var(--space-lg)"></div>
            <div class="button-row" style="margin-top: var(--space-lg)"><button class="button" type="submit">Generate JSON-LD <span aria-hidden="true">→</span></button><button class="button secondary" type="button" id="schema-sample">Load sample</button></div>
          </form>
          <p id="schema-status" class="status" aria-live="polite"></p>
        </div>
      </section>
      <aside class="tool-card result-panel" aria-labelledby="schema-result-title">
        <div class="tool-card__head"><div><p class="eyebrow">Output</p><h2 id="schema-result-title">Paste-ready script</h2></div><span class="mono">JSON-LD</span></div>
        <div class="tool-card__body"><code class="code-output" id="schema-output">Choose a type and add the fields you want to publish.</code><button class="button" type="button" id="copy-schema">Copy script</button><div class="tool-note"><p><strong>Eligibility is not a promise.</strong></p><p>Valid structured data helps search engines understand a page; Google independently decides whether to show any rich result.</p></div></div>
      </aside>
    </div>
    <section class="section" aria-labelledby="schema-faq-title"><div class="section-head"><div><p class="eyebrow">Notes</p><h2 id="schema-faq-title">Markup should describe what users can see.</h2></div><p>Keep the generated fields aligned with the visible page, then test the result with Google’s Rich Results Test and Schema Markup Validator.</p></div><div class="faq-list"><details open><summary>What is JSON-LD?</summary><p>JSON-LD is a JSON-based format for embedding linked data in a page, usually inside a script element in the document head or body.</p></details><details><summary>Does schema guarantee a rich result?</summary><p>No. Eligibility, page quality, search intent, and Google’s systems all affect whether an enhanced result appears.</p></details><details><summary>Should I add every schema type?</summary><p>No. Start with the type that best describes the page. Duplicate or misleading markup is worse than a smaller, accurate graph.</p></details></div></section>
    <ToolFooterContent title="Structure is part of the content." copy="A clean generator is useful when it keeps the page’s visible promise and its machine-readable version aligned." href="/favicon-generator/" label="Next: make a favicon" />
  </main>
</BaseLayout>

<script>
  import { generateSchema, jsonLdScript, validateSchema, type SchemaFields, type SchemaType } from '../../lib/schema';

  const typeSelect = document.querySelector<HTMLSelectElement>('#schema-type');
  const fieldsContainer = document.querySelector<HTMLElement>('#schema-fields');
  const output = document.querySelector<HTMLElement>('#schema-output');
  const status = document.querySelector<HTMLElement>('#schema-status');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-schema');
  const configs: Record<SchemaType, Array<{ key: string; label: string; placeholder: string; full?: boolean }>> = {
    Article: [{ key: 'headline', label: 'Headline', placeholder: 'A clear article headline', full: true }, { key: 'author', label: 'Author name', placeholder: 'Author name' }, { key: 'datePublished', label: 'Published date', placeholder: '2026-08-22' }, { key: 'image', label: 'Image URL', placeholder: 'https://example.com/image.jpg', full: true }, { key: 'url', label: 'Article URL', placeholder: 'https://example.com/article', full: true }],
    Organization: [{ key: 'name', label: 'Organization name', placeholder: 'Signal Tools', full: true }, { key: 'url', label: 'Website URL', placeholder: 'https://example.com' }, { key: 'logo', label: 'Logo URL', placeholder: 'https://example.com/logo.png' }, { key: 'sameAs', label: 'Profile URLs, one per line', placeholder: 'https://linkedin.com/company/example', full: true }],
    Product: [{ key: 'name', label: 'Product name', placeholder: 'Product name', full: true }, { key: 'description', label: 'Description', placeholder: 'A concise product description', full: true }, { key: 'image', label: 'Image URL', placeholder: 'https://example.com/product.jpg' }, { key: 'price', label: 'Price', placeholder: '49.00' }, { key: 'currency', label: 'Currency', placeholder: 'USD' }, { key: 'url', label: 'Product URL', placeholder: 'https://example.com/product', full: true }],
    Event: [{ key: 'name', label: 'Event name', placeholder: 'Event name', full: true }, { key: 'description', label: 'Description', placeholder: 'What will happen?', full: true }, { key: 'startDate', label: 'Start date/time', placeholder: '2026-09-01T09:00:00Z' }, { key: 'endDate', label: 'End date/time', placeholder: '2026-09-01T10:00:00Z' }, { key: 'url', label: 'Event URL', placeholder: 'https://example.com/event', full: true }],
    LocalBusiness: [{ key: 'name', label: 'Business name', placeholder: 'Business name', full: true }, { key: 'url', label: 'Website URL', placeholder: 'https://example.com' }, { key: 'telephone', label: 'Telephone', placeholder: '+1 555 555 5555' }, { key: 'streetAddress', label: 'Street address', placeholder: '123 Main Street', full: true }, { key: 'city', label: 'City', placeholder: 'Austin' }, { key: 'region', label: 'Region', placeholder: 'TX' }, { key: 'postalCode', label: 'Postal code', placeholder: '78701' }, { key: 'country', label: 'Country', placeholder: 'US' }],
    FAQPage: [{ key: 'questions', label: 'Questions and answers', placeholder: 'Add one question and answer below.', full: true }],
    BreadcrumbList: [{ key: 'items', label: 'Breadcrumb items', placeholder: 'Add one label and URL per line.', full: true }],
  };
  function setStatus(message: string, tone: 'info' | 'success' | 'error' = 'info') { if (status) { status.textContent = message; status.dataset.tone = tone; } }
  function renderFields(type: SchemaType) {
    if (!fieldsContainer) return;
    fieldsContainer.innerHTML = configs[type].map((config) => `<div class="field ${config.full ? 'full' : ''}"><label for="schema-${config.key}">${config.label}</label>${config.key === 'questions' || config.key === 'items' || config.key === 'sameAs' ? `<textarea id="schema-${config.key}" placeholder="${config.placeholder}"></textarea>` : `<input id="schema-${config.key}" placeholder="${config.placeholder}" />`}<p class="field__error">This field is recommended for a useful output.</p></div>`).join('');
    fieldsContainer.querySelectorAll('input, textarea').forEach((input) => input.addEventListener('input', generate));
    generate();
  }
  function collectFields(type: SchemaType): SchemaFields {
    const fields: SchemaFields = {};
    configs[type].forEach(({ key }) => { const input = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#schema-${key}`); if (!input) return; if (key === 'questions') fields[key] = input.value.split('\n').filter(Boolean).map((line) => { const [question, answer = ''] = line.split('::'); return { question, answer }; }); else if (key === 'items') fields[key] = input.value.split('\n').filter(Boolean).map((line) => { const [name, url = ''] = line.split('|'); return { name, url }; }); else fields[key] = input.value; });
    return fields;
  }
  function generate() {
    const type = (typeSelect?.value ?? 'Article') as SchemaType;
    const fields = collectFields(type);
    const schema = generateSchema(type, fields);
    if (output) output.textContent = jsonLdScript(schema);
    const issues = validateSchema(type, fields);
    setStatus(issues.length ? issues.join(' ') : 'Script updated. Validate it against the final page before publishing.', issues.length ? 'info' : 'success');
  }
  typeSelect?.addEventListener('change', () => renderFields(typeSelect.value as SchemaType));
  document.querySelector<HTMLButtonElement>('#schema-sample')?.addEventListener('click', () => { const type = typeSelect?.value as SchemaType; renderFields(type); if (type === 'Article') { (document.querySelector('#schema-headline') as HTMLInputElement).value = 'How to make a reliable launch checklist'; (document.querySelector('#schema-author') as HTMLInputElement).value = 'Maya Okonkwo'; (document.querySelector('#schema-datePublished') as HTMLInputElement).value = '2026-08-22'; (document.querySelector('#schema-url') as HTMLInputElement).value = 'https://example.com/launch-checklist'; } else if (type === 'FAQPage') (document.querySelector('#schema-questions') as HTMLTextAreaElement).value = 'What is Signal Tools?::A focused suite of browser-first utilities.\nDoes it upload data?::No, the tools run locally where possible.'; else if (type === 'BreadcrumbList') (document.querySelector('#schema-items') as HTMLTextAreaElement).value = 'Home|https://example.com/\nGuides|https://example.com/guides\nLaunch checklist|https://example.com/guides/launch-checklist'; generate(); });
  copyButton?.addEventListener('click', async () => { await navigator.clipboard.writeText(output?.textContent ?? ''); copyButton.textContent = 'Copied'; copyButton.dataset.state = 'success'; window.setTimeout(() => { copyButton.textContent = 'Copy script'; delete copyButton.dataset.state; }, 2500); });
  renderFields('Article');
</script>
