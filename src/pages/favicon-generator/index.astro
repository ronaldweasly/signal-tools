---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIntro from '../../components/ToolIntro.astro';
import ToolFooterContent from '../../components/ToolFooterContent.astro';
---
<BaseLayout title="Favicon Generator — create a clean icon set" description="Create a browser-first favicon SVG, preview the icon at common sizes, and copy the HTML tags needed to install it." currentPath="/favicon-generator/">
  <main class="site-main site-shell">
    <ToolIntro eyebrow="Brand surface" title="Make the smallest mark work harder." lede="Create a crisp text-based favicon, preview it at common browser sizes, and export the SVG plus installation snippet without uploading the design." detail="Browser-first · SVG + PNG export" />
    <div class="tool-grid">
      <section class="tool-card" aria-labelledby="favicon-form-title">
        <div class="tool-card__head"><div><p class="eyebrow">Icon recipe</p><h2 id="favicon-form-title">Favicon maker</h2></div><span class="mono muted">icon_01</span></div>
        <div class="tool-card__body">
          <form id="favicon-form">
            <div class="field-grid">
              <div class="field full"><label for="icon-label">Letters or mark</label><input id="icon-label" value="ST" maxlength="2" placeholder="ST" /><p class="field__hint">Use one or two characters for a legible small-size mark.</p></div>
              <div class="field"><label for="icon-background">Background</label><input id="icon-background" type="color" value="#1F3E57" /></div>
              <div class="field"><label for="icon-foreground">Foreground</label><input id="icon-foreground" type="color" value="#F5F7F8" /></div>
              <div class="field full"><label for="icon-shape">Shape</label><select id="icon-shape"><option value="rounded">Rounded square</option><option value="square">Square</option><option value="circle">Circle</option></select></div>
            </div>
            <div class="button-row" style="margin-top: var(--space-lg)"><button class="button" type="submit">Update preview <span aria-hidden="true">→</span></button><button class="button secondary" type="button" id="favicon-sample">Use sample</button></div>
          </form>
          <p id="favicon-status" class="status" aria-live="polite"></p>
        </div>
      </section>
      <aside class="tool-card result-panel" aria-labelledby="favicon-result-title">
        <div class="tool-card__head"><div><p class="eyebrow">Preview</p><h2 id="favicon-result-title">At a glance</h2></div><span class="mono">256 → 16</span></div>
        <div class="tool-card__body">
          <div class="favicon-preview" id="icon-preview" aria-label="Favicon preview"></div>
          <div class="favicon-sizes"><div><span>Tab</span><span class="size-chip size-16" id="size-16"></span></div><div><span>32px</span><span class="size-chip size-32" id="size-32"></span></div><div><span>180px</span><span class="size-chip size-180" id="size-180"></span></div></div>
          <div class="button-row"><button class="button" type="button" id="download-svg">Download SVG</button><button class="button secondary" type="button" id="copy-favicon-snippet">Copy HTML</button></div>
          <code class="code-output" id="favicon-snippet"></code>
        </div>
      </aside>
    </div>
    <section class="section" aria-labelledby="favicon-faq-title"><div class="section-head"><div><p class="eyebrow">Notes</p><h2 id="favicon-faq-title">Small surfaces punish fuzzy details.</h2></div><p>Keep the mark simple, preserve contrast, and install both the SVG and a small PNG fallback when a broad browser/device mix matters.</p></div><div class="faq-list"><details open><summary>What size should a favicon be?</summary><p>Browsers commonly use 16×16 and 32×32 icons, while Apple touch icons use a larger square such as 180×180. A responsive SVG can complement those PNG sizes.</p></details><details><summary>Does the tool upload my icon?</summary><p>No. This version creates the SVG in the browser. Nothing is sent to a server.</p></details><details><summary>Can I use a real image instead of letters?</summary><p>The current build focuses on a legible text mark. Image upload and raster optimization are a natural next iteration if the workflow proves useful.</p></details></div></section>
    <ToolFooterContent title="The mark should survive the smallest context." copy="Check the tab-sized preview before you spend time polishing the large version." href="/utm-builder/" label="Back: build a tracked link" />
  </main>
</BaseLayout>

<style>
  .favicon-preview { display: grid; place-items: center; min-height: 190px; border: var(--rule-hair) solid color-mix(in oklch, var(--color-paper) 18%, transparent); border-radius: var(--radius-md); background: color-mix(in oklch, var(--color-ink) 86%, var(--color-paper)); }
  .favicon-preview svg { width: min(180px, 45vw); height: min(180px, 45vw); }
  .favicon-sizes { display: flex; align-items: end; gap: var(--space-lg); padding-block: var(--space-lg); }
  .favicon-sizes > div { display: grid; justify-items: center; gap: var(--space-xs); color: color-mix(in oklch, var(--color-paper) 66%, transparent); font: var(--text-xs)/1 var(--font-mono); }
  .size-chip { display: block; border-radius: var(--radius-sm); background: var(--color-accent); }
  .size-16 { width: 16px; height: 16px; }
  .size-32 { width: 32px; height: 32px; }
  .size-180 { width: 64px; height: 64px; }
</style>

<script>
  import { faviconSnippet, faviconSvg, type FaviconOptions } from '../../lib/favicon';

  const form = document.querySelector<HTMLFormElement>('#favicon-form');
  const preview = document.querySelector<HTMLElement>('#icon-preview');
  const snippet = document.querySelector<HTMLElement>('#favicon-snippet');
  const status = document.querySelector<HTMLElement>('#favicon-status');
  let currentSvg = '';
  function options(): FaviconOptions { return { label: document.querySelector<HTMLInputElement>('#icon-label')?.value ?? 'ST', background: document.querySelector<HTMLInputElement>('#icon-background')?.value ?? '#1F3E57', foreground: document.querySelector<HTMLInputElement>('#icon-foreground')?.value ?? '#F5F7F8', shape: (document.querySelector<HTMLSelectElement>('#icon-shape')?.value ?? 'rounded') as FaviconOptions['shape'] }; }
  function setStatus(message: string, tone: 'info' | 'success' | 'error' = 'info') { if (status) { status.textContent = message; status.dataset.tone = tone; } }
  function render() { currentSvg = faviconSvg(options()); if (preview) preview.innerHTML = currentSvg; if (snippet) snippet.textContent = faviconSnippet(); setStatus('Preview updated locally. Download the SVG or copy the install tags.', 'success'); }
  form?.addEventListener('submit', (event) => { event.preventDefault(); render(); });
  form?.addEventListener('input', () => render());
  document.querySelector<HTMLButtonElement>('#favicon-sample')?.addEventListener('click', () => { const values = { '#icon-label': 'SQ', '#icon-background': '#6E513C', '#icon-foreground': '#F8F1E5', '#icon-shape': 'circle' }; Object.entries(values).forEach(([selector, value]) => { const input = document.querySelector<HTMLInputElement | HTMLSelectElement>(selector); if (input) input.value = value; }); render(); });
  document.querySelector<HTMLButtonElement>('#download-svg')?.addEventListener('click', () => { const blob = new Blob([currentSvg], { type: 'image/svg+xml;charset=utf-8' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'favicon.svg'; link.click(); URL.revokeObjectURL(link.href); });
  document.querySelector<HTMLButtonElement>('#copy-favicon-snippet')?.addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; await navigator.clipboard.writeText(faviconSnippet()); button.textContent = 'Copied'; button.dataset.state = 'success'; window.setTimeout(() => { button.textContent = 'Copy HTML'; delete button.dataset.state; }, 2500); });
  render();
</script>
