---
interface Props { title: string; copy: string; href: string; label: string }
const { title, copy, href, label } = Astro.props;
---
<section class="section" aria-labelledby="tool-notes-title">
  <div class="section-head">
    <div><p class="eyebrow">Working notes</p><h2 id="tool-notes-title">{title}</h2></div>
    <p>{copy}</p>
  </div>
  <div class="button-row"><a class="button secondary" href={href}>{label} <span aria-hidden="true">→</span></a><a class="button secondary" href="/">Browse all tools <span aria-hidden="true">↗</span></a></div>
</section>
