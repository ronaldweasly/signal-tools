---
interface Props { currentPath?: string }
const { currentPath = '/' } = Astro.props;
const links = [
  { href: '/#json-workspace', label: 'Open editor' },
  { href: '/research/', label: 'Research' },
  { href: '/about/', label: 'About' },
];
---
<nav class="site-nav" aria-label="Primary" data-open="false">
  <a class="site-nav__brand" href="/" aria-label="JSON Lens home">
    <span class="brand-mark" aria-hidden="true"></span>
    JSON Lens
  </a>
  <ul class="site-nav__links">
    {links.map((link) => (
      <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>
    ))}
  </ul>
  <span class="site-nav__meta">local / no upload</span>
  <button class="site-nav__menu" type="button" aria-label="Open navigation menu" aria-expanded="false">Menu</button>
</nav>
<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const menu = nav?.querySelector<HTMLButtonElement>('.site-nav__menu');
  menu?.addEventListener('click', () => {
    const open = nav?.dataset.open === 'true';
    if (nav) nav.dataset.open = String(!open);
    menu.setAttribute('aria-expanded', String(!open));
    menu.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu');
  });
</script>
