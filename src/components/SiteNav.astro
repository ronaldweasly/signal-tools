---
interface Props { currentPath?: string }
const { currentPath = '/' } = Astro.props;
const links = [
  { href: '/#json-workspace', label: 'Open editor' },
  { href: '/research/', label: 'Research' },
  { href: '/about/', label: 'About' },
];
---
<nav class="site-nav" aria-label="Primary" data-open="false">
  <a class="site-nav__brand" href="/" aria-label="JSON Lens home">
    <span class="brand-mark" aria-hidden="true"></span>
    JSON Lens
  </a>
  <ul id="primary-navigation" class="site-nav__links">
    {links.map((link) => (
      <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>
    ))}
  </ul>
  <span class="site-nav__meta">local / no upload</span>
  <button class="site-nav__menu" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-navigation">Menu</button>
</nav>
<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const menu = nav?.querySelector<HTMLButtonElement>('.site-nav__menu');
  const closeMenu = (restoreFocus = false) => {
    if (!nav || !menu) return;
    nav.dataset.open = 'false';
    menu.setAttribute('aria-expanded', 'false');
    menu.setAttribute('aria-label', 'Open navigation menu');
    if (restoreFocus) menu.focus();
  };

  menu?.addEventListener('click', () => {
    const open = nav?.dataset.open === 'true';
    if (open) closeMenu();
    else {
      nav?.setAttribute('data-open', 'true');
      menu.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-label', 'Close navigation menu');
    }
  });

  nav?.querySelectorAll<HTMLAnchorElement>('.site-nav__links a').forEach((link) => {
    link.addEventListener('click', () => closeMenu());
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.dataset.open === 'true') {
      event.preventDefault();
      closeMenu(true);
    }
  });

  document.addEventListener('click', (event) => {
    if (nav?.dataset.open === 'true' && event.target instanceof Node && !nav.contains(event.target)) closeMenu();
  });
</script>
