---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
}

const { title, description, canonicalPath, noindex = false } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(canonicalPath, siteUrl).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'JSON Lens',
  url: siteUrl.toString(),
  description,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'JSON formatter and validator',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  featureList: 'Format JSON, validate JSON, repair common JSON syntax, compare JSON, inspect JSON trees',
};
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0b1712" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="manifest" href="/manifest.webmanifest" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="JSON Lens" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>
